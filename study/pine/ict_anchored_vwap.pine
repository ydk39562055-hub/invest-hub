//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  ICT Sweep-Anchored VWAP   v1.0
//  스윕 캔들에 앵커링한 VWAP + σ 밴드 + 재탈환(RECLAIM) / 무효화(FAIL) 판정
//
//  앵커 모드
//   · 연동 : "ICT Sweep + MSS" 의 히든 플롯 "▸ Sweep Signal" 을 소스로 선택하면 스윕마다 자동 앵커 (권장)
//   · 내장 : PDH/PDL · HTF 스윙 스윕을 자체 감지해 자동 앵커 (단독 사용)
//   · 수동 : 인디케이터를 추가할 때 차트에서 스윕 캔들을 클릭
//
//  판정
//   · RECLAIM : 저점 스윕(롱) 앵커 후 종가가 VWAP 위에서 N봉 연속 유지 (숏은 반대)
//   · FAIL    : 스윕 캔들의 극단값을 종가로 뚫음 → 셋업 무효화
//
//  1분봉 : 연속 종가 수 3 권장. 5분봉 2, 15분봉 1~2.
// ═══════════════════════════════════════════════════════════════════════════════
indicator("ICT Sweep-Anchored VWAP", "ICT AVWAP", overlay = true, max_labels_count = 200)

// ─── 입력 ──────────────────────────────────────────────────────────────────────
gA = "앵커 (Anchor)"
mode     = input.string("연동", "앵커 모드", options = ["연동", "내장", "수동"], group = gA)
srcSig   = input.source(close, "연동: 스윕 신호 소스 (▸ Sweep Signal 선택)", group = gA,
     tooltip = "ICT Sweep + MSS 인디케이터의 '▸ Sweep Signal' 플롯을 고른다. 다른 값이면 앵커가 잡히지 않는다")
extOnly  = input.bool(true, "연동: 외부 유동성 스윕만 앵커", group = gA)
htfTfIn  = input.timeframe("15", "내장: HTF 스윙 타임프레임", group = gA)
htfLen   = input.int(5, "내장: HTF 스윙 피벗 길이", minval = 2, group = gA)
anchorT  = input.time(timestamp("2026-01-01 00:00 +0000"), "수동: 스윕 캔들 클릭", confirm = true, group = gA)
srcPrice = input.source(hlc3, "VWAP 가격 소스", group = gA)

gB = "밴드 · 판정"
showBands = input.bool(true, "σ 밴드 표시", group = gB)
sd1       = input.float(1.0, "밴드 1 (σ)", minval = 0.1, step = 0.5, group = gB)
sd2       = input.float(2.0, "밴드 2 (σ)", minval = 0.1, step = 0.5, group = gB)
holdBars  = input.int(2, "재탈환 확정: 연속 종가 수", minval = 1, group = gB, tooltip = "1분봉 3, 5분봉 2, 15분봉 1~2")
keepPrev  = input.bool(true, "이전 앵커 VWAP 유지 (회색)", group = gB)

// ─── 내장 스윕 감지 (PDH/PDL + HTF 스윙) ───────────────────────────────────────
tfSec = timeframe.in_seconds()
htfTf = timeframe.in_seconds(htfTfIn) > tfSec ? htfTfIn : timeframe.period

f_swings(simple int l) =>
    var float sh = na
    var float sl = na
    float ph = ta.pivothigh(high, l, l)
    float pl = ta.pivotlow(low, l, l)
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    [sh[1], sl[1]]

[htfH, htfL] = request.security(syminfo.tickerid, htfTf, f_swings(htfLen), lookahead = barmerge.lookahead_on)
[pdh, pdl]   = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

f_swHi(float lvl) =>
    not na(lvl) and high > lvl and close < lvl and close[1] <= lvl
f_swLo(float lvl) =>
    not na(lvl) and low < lvl and close > lvl and close[1] >= lvl

intHi = f_swHi(pdh) or f_swHi(htfH)
intLo = f_swLo(pdl) or f_swLo(htfL)

// ─── 앵커 이벤트 ───────────────────────────────────────────────────────────────
sigOK    = srcSig == 1 or srcSig == 2 or srcSig == -1 or srcSig == -2
linkBull = mode == "연동" and sigOK and srcSig > 0 and (not extOnly or srcSig == 2)
linkBear = mode == "연동" and sigOK and srcSig < 0 and (not extOnly or srcSig == -2)
manual   = mode == "수동" and time >= anchorT and (na(time[1]) or time[1] < anchorT)
manDir   = (open + close) / 2 - low > high - (open + close) / 2 ? 1 : -1   // 아래 꼬리가 길면 저점 스윕

anchorBull = linkBull or (mode == "내장" and intLo) or (manual and manDir == 1)
anchorBear = linkBear or (mode == "내장" and intHi) or (manual and manDir == -1)
anchorEvt  = anchorBull or anchorBear

// ─── 누적 ──────────────────────────────────────────────────────────────────────
var float sPV  = 0.0
var float sV   = 0.0
var float sPV2 = 0.0
var int   aBar = na
var int   aDir = 0
var float aLvl = na
var bool  reclaimed = false
var bool  failed    = false
var int   hold      = 0

var float pPV  = 0.0
var float pV   = 0.0
var int   pBar = na

if anchorEvt
    if keepPrev and not na(aBar)
        pPV  := sPV
        pV   := sV
        pBar := aBar
    sPV  := 0.0
    sV   := 0.0
    sPV2 := 0.0
    aBar := bar_index
    aDir := anchorBull ? 1 : -1
    aLvl := anchorBull ? low : high
    reclaimed := false
    failed    := false
    hold      := 0

if not na(aBar)
    sPV  += srcPrice * volume
    sV   += volume
    sPV2 += srcPrice * srcPrice * volume
if keepPrev and not na(pBar)
    pPV += srcPrice * volume
    pV  += volume

avwap = not na(aBar) and sV > 0 ? sPV / sV : na
varc  = not na(avwap) ? math.max(sPV2 / sV - avwap * avwap, 0.0) : na
sd    = math.sqrt(varc)
pvwap = keepPrev and not na(pBar) and pV > 0 ? pPV / pV : na

// ─── 재탈환 / 무효화 ───────────────────────────────────────────────────────────
above = not na(avwap) and close > avwap
below = not na(avwap) and close < avwap
if not na(aBar) and bar_index > aBar
    hold := aDir == 1 ? (above ? hold + 1 : 0) : (below ? hold + 1 : 0)

reclaimEvt = not na(aBar) and not reclaimed and not failed and hold >= holdBars
if reclaimEvt
    reclaimed := true
failEvt = not na(aBar) and not failed and (aDir == 1 ? close < aLvl : close > aLvl)
if failEvt
    failed := true

// ─── 그리기 ────────────────────────────────────────────────────────────────────
vcol = failed ? color.new(color.gray, 40) : aDir == 1 ? color.lime : color.red
plot(avwap, "Anchored VWAP", vcol, 2)
u1 = plot(showBands ? avwap + sd * sd1 : na, "+σ1", color.new(color.gray, 60), 1)
l1 = plot(showBands ? avwap - sd * sd1 : na, "-σ1", color.new(color.gray, 60), 1)
plot(showBands ? avwap + sd * sd2 : na, "+σ2", color.new(color.gray, 75), 1, plot.style_circles)
plot(showBands ? avwap - sd * sd2 : na, "-σ2", color.new(color.gray, 75), 1, plot.style_circles)
fill(u1, l1, color.new(color.gray, 92), title = "σ1 영역")
plot(pvwap, "이전 AVWAP", color.new(color.gray, 50), 1)
plot(not na(aBar) ? aLvl : na, "스윕 극단값 (무효화선)", color.new(color.orange, 50), 1, plot.style_linebr)

if anchorEvt
    label.new(bar_index, anchorBull ? low : high, anchorBull ? "AVWAP ▲" : "AVWAP ▼",
         style = anchorBull ? label.style_label_up : label.style_label_down,
         color = color.new(anchorBull ? color.lime : color.red, 30), textcolor = color.white, size = size.tiny)
if reclaimEvt
    label.new(bar_index, aDir == 1 ? low : high, "RECLAIM",
         style = aDir == 1 ? label.style_label_up : label.style_label_down,
         color = color.new(color.aqua, 20), textcolor = color.black, size = size.small)
if failEvt
    label.new(bar_index, aDir == 1 ? low : high, "FAIL",
         style = aDir == 1 ? label.style_label_up : label.style_label_down,
         color = color.new(color.gray, 20), textcolor = color.white, size = size.small)

// 거래량 없는 심볼 경고
cumVol = ta.cum(nz(volume))
var table tb = table.new(position.bottom_right, 1, 1, bgcolor = color.new(color.red, 70))
if barstate.islast and cumVol == 0
    table.cell(tb, 0, 0, "거래량 데이터 없음 — VWAP 계산 불가", text_color = color.white, text_size = size.small)

// ─── 히든 플롯 ─────────────────────────────────────────────────────────────────
plot(reclaimEvt ? aDir : 0, "▸ Reclaim Signal", display = display.none)
plot(failEvt ? aDir : 0, "▸ Fail Signal", display = display.none)

// ─── 알림 ──────────────────────────────────────────────────────────────────────
alertcondition(anchorEvt, "AVWAP 앵커 설정", "스윕 캔들에 AVWAP 앵커")
alertcondition(reclaimEvt, "AVWAP 재탈환", "AVWAP RECLAIM")
alertcondition(failEvt, "AVWAP 무효화", "AVWAP FAIL")
if reclaimEvt
    alert((aDir == 1 ? "롱 " : "숏 ") + "AVWAP 재탈환 " + syminfo.ticker, alert.freq_once_per_bar_close)
